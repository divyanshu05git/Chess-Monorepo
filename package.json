{
  "name": "chess-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "contract:emit": "npm run contract:emit --workspace=@repo/db"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@repo/common": "^1.0.0",
    "axios": "^1.21.0"
  }
}
