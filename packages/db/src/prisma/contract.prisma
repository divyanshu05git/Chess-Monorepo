// use prisma-8

model User {
  id String @id      @onCreate(uuid())
  email     String   @unique
  googleId  String   @unique
  username  String?
  name      String?
  password  String?
  gamesP1    Game[] @relation("player1")
  gamesP2    Game[] @relation("player2")
  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString
}

model Game {
  id        Int      @id @default(autoincrement())
  player1Id  String
  player1   User     @relation("player1",fields: [player1Id], references: [id])
  player2Id  String
  player2   User     @relation("player2",fields: [player2Id], references: [id])
  moves     Move[]   
  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString
  result    String?   
  status    String   @default("ONGOING")
}

model Move{
  id        Int      @id @default(autoincrement())
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id])
  playerId  String
  player    User     @relation("movePlayer", fields: [playerId], references: [id])
  from       String
  to         String
  notation   String?
  moveNumber Int

  @@unique([gameId, moveNumber])
}
