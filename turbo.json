{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // "globalEnv": ["DATABASE_URL"], 
  "tasks": {
    "build": {
      "dependsOn": ["^build","^contract:emit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
